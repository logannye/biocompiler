  "probe_source": "\nimport hashlib,json,re,sys\nfrom pathlib import Path\nfrom biocompiler.semantics.types import TypeSpec,decode_binding\ntext=Path('core/test/test_domain.ml').read_text()\ncases=re.findall(r'check \"([^\"]+)\"\\s+\\{\\|(.*?)\\|\\}\\s+\\{\\|(.*?)\\|\\}',text,re.S)\norders={'scalar':['kind','value','unit','canonical_value','type'],'interval':['kind','lower','upper','type'],'curve':['kind','type','points','interpolation','extrapolation']}\ndef exact(v,sort=False):return json.dumps(v,ensure_ascii=False,sort_keys=sort,separators=(',',':'),allow_nan=False)\ndef walk(v,path=()):\n expected=orders[v['kind']];actual=list(v);assert actual==expected,(path,actual)\n rows=[{'path':list(path),'kind':v['kind'],'keys':actual,'expected_keys':expected,'status':'pass'}]\n if v['kind']=='interval':\n  rows.extend(walk(v['lower'],path+('lower',)));rows.extend(walk(v['upper'],path+('upper',)))\n elif v['kind']=='curve':\n  for i,pair in enumerate(v['points']):\n   for j,child in enumerate(pair):rows.extend(walk(child,path+('points',i,j)))\n return rows\ndef reverse(v):\n if isinstance(v,dict):return {k:reverse(x) for k,x in reversed(list(v.items()))}\n if isinstance(v,list):return [reverse(x) for x in v]\n return v\nrows=[]\nfor name,raw,wanted in cases:\n value=json.loads(raw);expected=json.loads(wanted);dtype=TypeSpec.from_dict(value['type'])\n actual=decode_binding(value,dtype).to_dict();reordered=decode_binding(reverse(value),dtype).to_dict()\n repeated=decode_binding(actual,TypeSpec.from_dict(actual['type'])).to_dict()\n assert exact(actual,True)==exact(expected,True),name\n assert exact(actual)==exact(reordered)==exact(repeated),name\n rows.append({'name':name,'status':'pass','input_json':raw,'expected_json':wanted,'expected_semantic_encoding':exact(expected,True),'actual_semantic_encoding':exact(actual,True),'actual_ordered_encoding':exact(actual),'reversed_input_json':exact(reverse(value)),'reversed_output_encoding':exact(reordered),'repeated_output_encoding':exact(repeated),'recursive_order':walk(actual),'reversed_recursive_order':walk(reordered),'repeated_recursive_order':walk(repeated)})\nassert len(rows)==8,len(rows)\nprint(json.dumps({'python_version':sys.version.split()[0],'python_executable':sys.executable,'case_count':len(rows),'status':'pass','cases':rows},sort_keys=True))\n",
